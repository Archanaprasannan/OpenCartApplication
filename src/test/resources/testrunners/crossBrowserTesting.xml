<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Opencart App Test Suite" verbose="4" thread-count="4" parallel="tests">

	<test name="Login Page Test_chrome">
	<parameter name="browser" value="chrome"></parameter>
		<classes>
			<class name="com.qa.automation.opencart.test.LoginPageTest" />
		</classes>
	</test>
	
	
	<test name="Login Page Test_Firefox">
	<parameter name="browser" value="firefox"></parameter>
		<classes>
			<class name="com.qa.automation.opencart.test.LoginPageTest" />
		</classes>
	</test>
	
	
	<test name="Login Page Test_Edge">
	<parameter name="browser" value="edge"></parameter>
		<classes>
			<class name="com.qa.automation.opencart.test.LoginPageTest" />
		</classes>
	</test>
	
	<test name="Register Page Test_chrome">
	<parameter name="browser" value="chrome"></parameter>
		<classes>
			<class name="com.qa.automation.opencart.test.RegisterPageTest" />
		</classes>
	</test>
	
	<test name="Register Page Test_firefox">
	<parameter name="browser" value="firefox"></parameter>
		<classes>
			<class name="com.qa.automation.opencart.test.RegisterPageTest" />
		</classes>
	</test>
	
	<test name="Register Page Test_edge">
	<parameter name="browser" value="edge"></parameter>
		<classes>
			<class name="com.qa.automation.opencart.test.RegisterPageTest" />
		</classes>
	</test>
	
	<test name="Account Page Test_chrome">
	<parameter name="browser" value="chrome"></parameter>
		<classes>
			<class name="com.qa.automation.opencart.test.AccountPageTest" />
		</classes>
	</test>
	
	<test name="Account Page Test_edge">
	<parameter name="browser" value="edge"></parameter>
		<classes>
			<class name="com.qa.automation.opencart.test.AccountPageTest" />
		</classes>
	</test>
	
	<test name="Account Page Test_firefox">
	<parameter name="browser" value="firefox"></parameter>
		<classes>
			<class name="com.qa.automation.opencart.test.AccountPageTest" />
		</classes>
	</test>


</suite>	